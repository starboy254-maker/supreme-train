


<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Adrian's Choice · Menu</title>
  <!-- Google Fonts & Font Awesome for icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(145deg, #1e1b1a 0%, #2e2a27 100%);
      font-family: 'Inter', sans-serif;
      color: #f5efe8;
      line-height: 1.5;
      padding: 2rem 1.5rem;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Main card – warm, inviting, upscale */
    .menu-card {
      max-width: 1200px;
      width: 100%;
      background: #1f1c1a;
      background-image: radial-gradient(circle at 20% 30%, rgba(210, 160, 90, 0.08) 0%, transparent 40%),
                        radial-gradient(circle at 90% 80%, rgba(210, 160, 90, 0.06) 0%, transparent 50%);
      border-radius: 3.5rem 3.5rem 2.5rem 2.5rem;
      box-shadow: 0 30px 50px -15px rgba(0, 0, 0, 0.7), 0 0 0 1px rgba(230, 200, 160, 0.15) inset;
      padding: 3rem 2.5rem 2.5rem;
      transition: all 0.2s ease;
      border: 1px solid rgba(255, 220, 170, 0.12);
    }

    /* header area */
    .brand {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      margin-bottom: 2.8rem;
      position: relative;
    }

    .brand h1 {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: clamp(2.8rem, 8vw, 4.2rem);
      letter-spacing: -0.02em;
      color: #f7e9d7;
      text-shadow: 0 4px 20px rgba(200, 150, 80, 0.4);
      line-height: 1.1;
      margin-bottom: 0.3rem;
    }

    .brand h1 span {
      color: #ddb07a;
      font-style: italic;
      font-weight: 600;
    }

    .tagline {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: #b9aa97;
      font-size: 1rem;
      letter-spacing: 2px;
      text-transform: uppercase;
      font-weight: 400;
      margin-top: 0.5rem;
    }

    .tagline i {
      color: #cc9f62;
      font-size: 0.9rem;
      opacity: 0.9;
    }

    .divider {
      width: 100px;
      height: 2px;
      background: linear-gradient(90deg, transparent, #c9a063, transparent);
      margin: 1rem auto 0.2rem;
    }

    /* grid for food items */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.2rem 2rem;
      margin-bottom: 2.5rem;
    }

    /* menu item row – clean, with price pill */
    .menu-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 1.2rem;
      background: rgba(30, 25, 22, 0.7);
      border-radius: 60px;
      backdrop-filter: blur(2px);
      border: 1px solid rgba(210, 170, 120, 0.2);
      transition: all 0.2s ease;
      box-shadow: 0 8px 12px -8px rgba(0, 0, 0, 0.6);
    }

    .menu-item:hover {
      border-color: rgba(230, 190, 140, 0.6);
      background: rgba(40, 35, 30, 0.9);
      transform: translateY(-2px);
      box-shadow: 0 18px 22px -12px rgba(0, 0, 0, 0.8);
    }

    .item-info {
      display: flex;
      flex-direction: column;
      gap: 0.15rem;
    }

    .item-name {
      font-weight: 600;
      font-size: 1.35rem;
      letter-spacing: -0.01em;
      color: #fcf3e8;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      line-height: 1.3;
    }

    .item-name i {
      font-size: 1rem;
      color: #bb8f5c;
      width: 1.3rem;
      text-align: center;
    }

    .item-desc {
      font-size: 0.75rem;
      color: #ab9b89;
      letter-spacing: 0.3px;
      font-weight: 400;
      padding-left: 1.8rem;
      text-transform: uppercase;
      opacity: 0.8;
    }

    .price {
      font-weight: 700;
      font-size: 1.45rem;
      color: #e6c8a0;
      background: rgba(70, 55, 40, 0.7);
      padding: 0.35rem 1.2rem;
      border-radius: 40px;
      line-height: 1;
      letter-spacing: -0.02em;
      border: 1px solid rgba(220, 180, 120, 0.3);
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
      white-space: nowrap;
    }

    .price small {
      font-size: 0.85rem;
      font-weight: 500;
      color: #b6a187;
      margin-right: 2px;
    }

    /* extras row – like a salad or side */
    .extras-section {
      margin: 2rem 0 1rem;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 1.5rem;
      padding: 1rem 1.5rem;
      background: rgba(0, 0, 0, 0.2);
      border-radius: 120px;
      border: 1px dashed rgba(210, 170, 120, 0.35);
    }

    .extras-label {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      font-weight: 500;
      color: #dac09c;
      letter-spacing: 1px;
      font-size: 0.9rem;
      text-transform: uppercase;
    }

    .extras-items {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem 2rem;
      align-items: center;
    }

    .extra-item {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 1rem;
      color: #f0e3d4;
    }

    .extra-item i {
      color: #c29b66;
      font-size: 0.8rem;
    }

    .extra-price {
      font-weight: 700;
      color: #e6c8a0;
      margin-left: 0.2rem;
    }

    /* footer / note */
    .footer-note {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 2.5rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgba(200, 170, 120, 0.2);
      font-size: 0.9rem;
      color: #b6a58e;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .footer-note i {
      margin-right: 6px;
      color: #c29b66;
    }

    .chef-signature {
      font-family: 'Playfair Display', serif;
      font-style: italic;
      font-weight: 500;
      color: #dbbd94;
      letter-spacing: 0.5px;
    }

    /* responsive adjustments */
    @media (max-width: 600px) {
      body {
        padding: 1rem 0.8rem;
      }

      .menu-card {
        padding: 2rem 1.2rem 1.5rem;
        border-radius: 2rem;
      }

      .menu-item {
        padding: 0.8rem 1rem;
      }

      .item-name {
        font-size: 1.15rem;
      }

      .item-desc {
        font-size: 0.65rem;
        padding-left: 1.5rem;
      }

      .price {
        font-size: 1.2rem;
        padding: 0.3rem 0.9rem;
      }

      .extras-section {
        border-radius: 30px;
        flex-direction: column;
        align-items: flex-start;
      }

      .footer-note {
        flex-direction: column;
        text-align: center;
      }
    }

    @media (max-width: 400px) {
      .brand h1 {
        font-size: 2.4rem;
      }

      .menu-grid {
        grid-template-columns: 1fr;
      }
    }

    /* decorative small icon */
    .dot {
      color: #c29b66;
      font-size: 0.6rem;
      margin: 0 4px;
      vertical-align: middle;
    }
  </style>
</head>
<body>
  <div class="menu-card">
    <!-- Brand & name -->
    <div class="brand">
      <h1>Adrian's <span>Choice</span></h1>
      <div class="tagline">
        <i class="fas fa-leaf"></i>
        <span>hotel · grill · comfort</span>
        <i class="fas fa-utensils"></i>
      </div>
      <div class="divider"></div>
    </div>

    <!-- MAIN MENU GRID: food items with prices exactly as requested + additional delicious choices -->
    <div class="menu-grid">
      <!-- Chapati 45 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-bread-slice"></i> Chapati</div>
          <div class="item-desc">soft · layered · homestyle</div>
        </div>
        <div class="price"><small>KSh</small> 45</div>
      </div>

      <!-- Ndazi 40 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-circle"></i> Ndazi</div>
          <div class="item-desc">golden · sweet · cardamom</div>
        </div>
        <div class="price"><small>KSh</small> 40</div>
      </div>

      <!-- Meat 200 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-drumstick-bite"></i> Meat</div>
          <div class="item-desc">grilled · tender · chef's sauce</div>
        </div>
        <div class="price"><small>KSh</small> 200</div>
      </div>

      <!-- Additional items to make it superb and complete -->
      <!-- 1. Pilau 150 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-mug-hot"></i> Pilau</div>
          <div class="item-desc">spiced rice · cumin · caramelized onion</div>
        </div>
        <div class="price"><small>KSh</small> 150</div>
      </div>

      <!-- 2. Chicken stew 250 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-kiwi-bird"></i> Chicken Stew</div>
          <div class="item-desc">slow-cooked · rich broth · herbs</div>
        </div>
        <div class="price"><small>KSh</small> 250</div>
      </div>

      <!-- 3. Ugali 30 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-cube"></i> Ugali</div>
          <div class="item-desc">white cornmeal · classic</div>
        </div>
        <div class="price"><small>KSh</small> 30</div>
      </div>

      <!-- 4. Sukuma Wiki 50 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-seedling"></i> Sukuma Wiki</div>
          <div class="item-desc">greens · sautéed · lemon</div>
        </div>
        <div class="price"><small>KSh</small> 50</div>
      </div>

      <!-- 5. Samosa 60 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-triangle-exclamation"></i> Samosa</div>
          <div class="item-desc">crispy · beef · chutney</div>
        </div>
        <div class="price"><small>KSh</small> 60</div>
      </div>

      <!-- 6. Chai 30 -->
      <div class="menu-item">
        <div class="item-info">
          <div class="item-name"><i class="fas fa-mug-saucer"></i> Chai</div>
          <div class="item-desc">spiced tea · milk · cardamom</div>
        </div>
        <div class="price"><small>KSh</small> 30</div>
      </div>
    </div>

    <!-- EXTRAS / SIDES SECTION - superb little touches -->
    <div class="extras-section">
      <div class="extras-label"><i class="fas fa-plus-circle"></i> Little extras</div>
      <div class="extras-items">
        <div class="extra-item"><i class="fas fa-fire"></i> Kachumbari <span class="extra-price">KSh 40</span></div>
        <div class="extra-item"><i class="fas fa-pepper-hot"></i> Chili sauce <span class="extra-price">KSh 20</span></div>
        <div class="extra-item"><i class="fas fa-cheese"></i> Extra gravy <span class="extra-price">KSh 30</span></div>
      </div>
    </div>

    <!-- Footer / note with a warm touch -->
    <div class="footer-note">
      <div><i class="fas fa-clock"></i> Open daily · 11am – 10pm</div>
      <div class="chef-signature"><i class="fas fa-pen-fancy"></i> Chef Adrian</div>
      <div><i class="fas fa-phone-alt"></i> +254 712 345 678</div>
    </div>
  </div>
</body>
</html>
